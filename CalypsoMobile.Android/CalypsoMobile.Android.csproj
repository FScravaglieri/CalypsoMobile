<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0-android</TargetFramework>
		<SupportedOSPlatformVersion>21</SupportedOSPlatformVersion>
		<CheckEolTargetFramework>false</CheckEolTargetFramework>
		<Nullable>enable</Nullable>
		<ApplicationId>com.calypso.mobile</ApplicationId>
		<ApplicationVersion>1</ApplicationVersion>
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<NoWarn>$(NoWarn);NETSDK1202</NoWarn>
		<AndroidPackageFormat>apk</AndroidPackageFormat>
	</PropertyGroup>


	<ItemGroup>
    <PackageReference Include="Avalonia.Android" Version="11.1.3" />
    <PackageReference Include="Microsoft.Maui.Essentials" Version="8.0.82" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CalypsoMobile\CalypsoMobile.csproj" />
  </ItemGroup>
</Project>
